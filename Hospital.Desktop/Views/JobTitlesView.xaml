<UserControl x:Class="Hospital.Desktop.Views.JobTitlesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             Background="{StaticResource PrimaryBackground}"
             FontFamily="{StaticResource AppFontFamily}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBackground}" CornerRadius="12" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.05" Color="Black"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Button Content="+ إضافة عنوان وظيفي" 
                        Command="{Binding AddCommand}" 
                        Style="{StaticResource PrimaryButton}" 
                        Width="170"/>

                <Button Content="تحديث" 
                        Command="{Binding RefreshCommand}" 
                        Style="{StaticResource SecondaryButton}" 
                        Margin="12,0" Width="100"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBackground}" CornerRadius="12" Padding="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.05" Color="Black"/>
            </Border.Effect>
            <Grid>
                <DataGrid ItemsSource="{Binding JobTitles}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          RowHeight="55"
                          Background="Transparent"
                          BorderThickness="0"
                          GridLinesVisibility="None"
                          HorizontalGridLinesBrush="{StaticResource BorderColor}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التسلسل" Binding="{Binding Id}" Width="100"/>
                        <DataGridTextColumn Header="العنوان الوظيفي" Binding="{Binding Title}" Width="*"/>

                        <DataGridTemplateColumn Header="الإجراءات" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="تعديل" 
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" 
                                                Foreground="{StaticResource PrimaryAccent}" Background="Transparent" FontWeight="SemiBold" Cursor="Hand"/>

                                        <Separator Width="1" Height="15" Margin="10,0" Background="{StaticResource BorderColor}"/>

                                        <Button Content="حذف" 
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" 
                                                Foreground="{StaticResource GovDanger}" Background="Transparent" FontWeight="SemiBold" Cursor="Hand"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <ProgressBar IsIndeterminate="True" 
                             Height="3" 
                             VerticalAlignment="Top" 
                             Foreground="{StaticResource PrimaryAccent}"
                             Background="Transparent"
                             BorderThickness="0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>