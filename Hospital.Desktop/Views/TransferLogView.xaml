<UserControl x:Class="Hospital.Desktop.Views.TransferLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource PrimaryBackground}"
             FontFamily="{StaticResource AppFontFamily}">

    <UserControl.Resources>
        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBackground}"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBackground}" CornerRadius="12" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.05" Color="Black"/>
            </Border.Effect>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ إجراء نقل جديد" 
                            Command="{Binding NewTransferCommand}" 
                            Style="{StaticResource PrimaryButton}"
                            Width="160">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="{StaticResource PrimaryAccentColor}"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="بحث باسم الموظف:" 
                               VerticalAlignment="Center" 
                               Foreground="{StaticResource TextMuted}" 
                               FontWeight="SemiBold"
                               Margin="0,0,12,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource SearchTextBox}"
                             Width="280"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBackground}" CornerRadius="12" Padding="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.05" Color="Black"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding Logs}" 
                      SelectedItem="{Binding SelectedLog, Mode=TwoWay}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      SelectionMode="Single"
                      RowHeight="55"
                      BorderThickness="0"
                      Background="Transparent"
                      GridLinesVisibility="None"
                      HorizontalGridLinesBrush="{StaticResource BorderColor}">

                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" 
                                  Command="{Binding ViewDetailsCommand}" 
                                  CommandParameter="{Binding SelectedLog}"/>
                </DataGrid.InputBindings>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="الموظف" Binding="{Binding EmployeeName}" Width="1.5*"/>
                    <DataGridTextColumn Header="من قسم" Binding="{Binding OldDepartmentName}" Width="1.2*"/>
                    <DataGridTextColumn Header="إلى قسم" Binding="{Binding NewDepartmentName}" Width="1.2*"/>
                    <DataGridTemplateColumn Header="رقم الكتاب" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AdOrderNumber}" 
                                           VerticalAlignment="Center" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource GovWarning}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="تاريخ النقل" Binding="{Binding TransferDate, StringFormat=yyyy/MM/dd}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBackground}" CornerRadius="12" Padding="10" Margin="0,15,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.03" Color="Black"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="السابق" 
                        Command="{Binding PrevPageCommand}" 
                        Style="{StaticResource SecondaryButton}"
                        Width="90"/>

                <Border Background="{StaticResource PrimaryBackground}" CornerRadius="6" Margin="25,0" Padding="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="صفحة " Foreground="{StaticResource TextMuted}" FontSize="13"/>
                        <TextBlock Text="{Binding CurrentPage}" FontWeight="Bold" Foreground="{StaticResource PrimaryAccent}" FontSize="14"/>
                        <TextBlock Text=" من " Foreground="{StaticResource TextMuted}" FontSize="13" Margin="5,0"/>
                        <TextBlock Text="{Binding TotalPages}" FontWeight="Bold" Foreground="{StaticResource PrimaryDark}" FontSize="14"/>
                    </StackPanel>
                </Border>

                <Button Content="التالي" 
                        Command="{Binding NextPageCommand}" 
                        Style="{StaticResource SecondaryButton}"
                        Width="90"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>