<UserControl x:Class="Hospital.Desktop.Views.AbsentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Hospital.Desktop.Converters"
             FlowDirection="RightToLeft"
             Background="{StaticResource PrimaryBackground}"
             FontFamily="{StaticResource AppFontFamily}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:DeleteRestoreConverter x:Key="DeleteRestoreConverter"/>

        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="ModernInput" TargetType="Control">
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBackground}" CornerRadius="12" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.05" Color="Black"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="اسم الموظف" Style="{StaticResource FilterLabel}"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Style="{StaticResource ModernInput}" Padding="8,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="التاريخ" Style="{StaticResource FilterLabel}"/>
                    <DatePicker SelectedDate="{Binding SearchDate}" Width="160" Style="{StaticResource ModernInput}"/>
                </StackPanel>

                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="حالة القيد" Style="{StaticResource FilterLabel}"/>
                    <ComboBox SelectedIndex="{Binding SelectedStatusFilter}" Width="130" Style="{StaticResource ModernInput}">
                        <ComboBoxItem Content="عرض الكل"/>
                        <ComboBoxItem Content="السجلات الفعالة"/>
                        <ComboBoxItem Content="الأرشيف"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                    <Button Content="+ إضافة غياب" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" Width="130" Height="38">
                    </Button>
                    <Button Content="تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Width="80" Height="38" Margin="10,0,0,0">
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBackground}" CornerRadius="12" Padding="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.05" Color="Black"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding Absents}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      RowHeight="55" 
                      BorderThickness="0" 
                      Background="Transparent"
                      GridLinesVisibility="None"
                      HorizontalGridLinesBrush="{StaticResource BorderColor}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBackground}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ت" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="اسم الموظف" Binding="{Binding EmployeeName}" Width="2*"/>
                    <DataGridTemplateColumn Header="تاريخ الغياب" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Date, StringFormat='{}{0:yyyy / MM / dd}'}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="الإجراءات" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}"
                                        Content="{Binding IsDeleted, Converter={StaticResource DeleteRestoreConverter}}"
                                        Foreground="{Binding IsDeleted, Converter={StaticResource DeleteRestoreConverter}, ConverterParameter=Color}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBackground}" CornerRadius="12" Padding="10" Margin="0,15,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.03" Color="Black"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="السابق" Command="{Binding PrevPageCommand}" Width="90" Height="35" Style="{StaticResource SecondaryButton}"/>

                <Border Background="{StaticResource PrimaryBackground}" CornerRadius="6" Margin="25,0" Padding="15,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="صفحة " Foreground="{StaticResource TextMuted}" FontSize="13"/>
                        <TextBlock Text="{Binding CurrentPage}" FontWeight="Bold" Foreground="{StaticResource PrimaryAccent}" FontSize="14"/>
                        <TextBlock Text=" من " Foreground="{StaticResource TextMuted}" FontSize="13"/>
                        <TextBlock Text="{Binding TotalPages}" FontWeight="Bold" Foreground="{StaticResource PrimaryDark}" FontSize="14"/>
                    </StackPanel>
                </Border>

                <Button Content="التالي" Command="{Binding NextPageCommand}" Width="90" Height="35" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>