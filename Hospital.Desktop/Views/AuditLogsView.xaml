<UserControl x:Class="Hospital.Desktop.Views.AuditLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource PrimaryBackground}"
             FontFamily="{StaticResource AppFontFamily}">

    <UserControl.Resources>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBackground}" CornerRadius="12" Padding="20" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.05"/>
            </Border.Effect>
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="سجلات الرقابة والتدقيق" Style="{StaticResource Header1}"/>
                    <TextBlock Text="مراقبة نشاط المستخدمين والعمليات الإدارية" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Content="تحديث السجلات" 
                        Command="{Binding RefreshCommand}" 
                        HorizontalAlignment="Right" 
                        Style="{StaticResource SecondaryButton}" 
                        Width="140"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBackground}" CornerRadius="12" Padding="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.05"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding Logs}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      RowHeight="55" 
                      BorderThickness="0" 
                      Background="Transparent"
                      GridLinesVisibility="None"
                      HorizontalGridLinesBrush="{StaticResource BorderColor}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding Date, StringFormat='{}{0:yyyy-MM-dd | HH:mm}'}" Width="180"/>

                    <DataGridTemplateColumn Header="المستخدم" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{StaticResource RowAlternate}" Width="24" Height="24" CornerRadius="12" Margin="0,0,8,0">
                                        <TextBlock Text="👤" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding UserName}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="العملية" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource RowSelected}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding ActionType}" Foreground="{StaticResource PrimaryAccent}" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="الهدف (Entity)" Binding="{Binding EntityName}" Width="150"/>

                    <DataGridTemplateColumn Header="رقم السجل" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RecordId, StringFormat='# {0}'}" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource MonoFontFamily}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBackground}" CornerRadius="12" Padding="10" Margin="0,15,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.03"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="السابق" Command="{Binding PrevPageCommand}" Width="90" Style="{StaticResource SecondaryButton}"/>

                <Border Background="{StaticResource PrimaryBackground}" CornerRadius="6" Margin="25,0" Padding="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="صفحة " Foreground="{StaticResource TextMuted}" FontSize="13"/>
                        <TextBlock Text="{Binding CurrentPage}" FontWeight="Bold" Foreground="{StaticResource PrimaryAccent}" FontSize="14"/>
                        <TextBlock Text=" من " Foreground="{StaticResource TextMuted}" FontSize="13" Margin="5,0"/>
                        <TextBlock Text="{Binding TotalPages}" FontWeight="Bold" Foreground="{StaticResource PrimaryDark}" FontSize="14"/>
                    </StackPanel>
                </Border>

                <Button Content="التالي" Command="{Binding NextPageCommand}" Width="90" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>