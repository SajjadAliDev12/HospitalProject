<Window x:Class="Hospital.Desktop.Views.AbsentFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل غياب جديد" 
        Height="400" Width="450" 
        WindowStartupLocation="CenterScreen" 
        FlowDirection="RightToLeft" 
        ResizeMode="NoResize"
        Background="{StaticResource PrimaryBackground}"
        FontFamily="{StaticResource AppFontFamily}">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ModernInput" TargetType="Control">
            <Setter Property="Height" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBackground}"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="45"/>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="45"/>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="البحث عن الموظف" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Employees}" 
                      DisplayMemberPath="Name" 
                      SelectedValuePath="Id" 
                      SelectedValue="{Binding Absent.EmployeeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      IsDropDownOpen="{Binding IsSelecting}"
                      IsEditable="True" 
                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                      StaysOpenOnEdit="True"
                      Style="{StaticResource ModernInput}"/>

            <TextBlock Text="* يرجى إدخال 3 أحرف على الأقل لبدء البحث" 
                       FontSize="11" 
                       Foreground="{StaticResource TextMuted}" 
                       Margin="0,6,0,0"/>

            <TextBlock Text="تاريخ الغياب" 
                       Style="{StaticResource FieldLabel}" 
                       Margin="0,20,0,8"/>

            <DatePicker SelectedDate="{Binding Absent.Date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        Style="{StaticResource ModernInput}"
                        BorderThickness="1"/>

            <Grid Margin="0,40,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Content="إتمام تسجيل الغياب" 
                        Command="{Binding SaveCommand}" 
                        Style="{StaticResource PrimaryBtn}" 
                        Margin="0,0,10,0"/>

                <Button Grid.Column="1" 
                        Content="إلغاء" 
                        IsCancel="True" 
                        Style="{StaticResource SecondaryBtn}"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>