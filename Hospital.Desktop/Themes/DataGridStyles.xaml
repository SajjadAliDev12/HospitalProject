<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared DataGrid set: comfortable padding, subtle row selection,
         full RTL support (flow direction comes from the host view).
         Opt-in via Style="{StaticResource GovDataGrid}". -->

    <Style x:Key="GovColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource GovBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource GovMutedText}"/>
        <Setter Property="FontFamily" Value="{StaticResource GovFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource GovBorder}"/>
    </Style>

    <Style x:Key="GovDataGridRow" TargetType="DataGridRow">
        <Setter Property="FontFamily" Value="{StaticResource GovFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource GovBodyText}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource GovPrimarySoft}"/>
                <Setter Property="Foreground" Value="{StaticResource GovInk}"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GovBackground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GovDataGridCell" TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource GovInk}"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GovDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GovBorder}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="48"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource GovColumnHeader}"/>
        <Setter Property="RowStyle" Value="{StaticResource GovDataGridRow}"/>
        <Setter Property="CellStyle" Value="{StaticResource GovDataGridCell}"/>
        <Setter Property="FontFamily" Value="{StaticResource GovFontFamily}"/>
    </Style>

    <!-- Unified input look (opt-in; keeps validation visuals visible) -->
    <Style x:Key="GovTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource GovFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource GovInk}"/>
        <Setter Property="Background" Value="{StaticResource GovSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GovBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource GovPrimary}"/>
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource GovDanger}"/>
                <Setter Property="ToolTip"
                        Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
