<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared button set. All buttons bind Background/Foreground locally;
         these styles only unify shape, typography and interaction. -->

    <Style x:Key="GovPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GovPrimary}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource GovFontFamily}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GovPrimaryDark}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource GovBorder}"/>
                <Setter Property="Foreground" Value="{StaticResource GovMutedText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GovSecondaryButton" TargetType="Button" BasedOn="{StaticResource GovPrimaryButton}">
        <Setter Property="Background" Value="{StaticResource GovSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource GovSlate}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource GovBorder}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GovBackground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GovDangerButton" TargetType="Button" BasedOn="{StaticResource GovPrimaryButton}">
        <Setter Property="Background" Value="{StaticResource GovDanger}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#7F1D1D"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GovGhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource GovFontFamily}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GovPrimarySoft}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
