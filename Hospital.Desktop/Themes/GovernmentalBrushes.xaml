<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Governmental Enterprise palette (single source of truth).
         Primary: deep navy slate. Accent: royal blue. Do NOT hardcode hex in views. -->

    <!-- Surfaces -->
    <!-- Domain employment-status states (kept: required by HR semantics, centralized).
         All other Gov* aliases were migrated to Colors.xaml canonical keys. -->
    <SolidColorBrush x:Key="GovSuccess" Color="#166534"/>
    <SolidColorBrush x:Key="GovSuccessSoft" Color="#F0FDF4"/>
    <SolidColorBrush x:Key="GovWarning" Color="#B45309"/>
    <SolidColorBrush x:Key="GovWarningSoft" Color="#FFFBEB"/>
    <SolidColorBrush x:Key="GovDanger" Color="#991B1B"/>
    <SolidColorBrush x:Key="GovDangerSoft" Color="#FEF2F2"/>

</ResourceDictionary>
