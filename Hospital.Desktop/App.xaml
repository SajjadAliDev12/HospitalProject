<Application x:Class="Hospital.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hospital.Desktop"
             xmlns:conv="clr-namespace:Hospital.Desktop.Converters"
             xmlns:vm="clr-namespace:Hospital.Desktop.ViewModels"
             xmlns:views="clr-namespace:Hospital.Desktop.Views"
             StartupUri="Views/LoginView.xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Typography.xaml"/>
                <ResourceDictionary Source="Themes/GovernmentalBrushes.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <conv:BooleanToStatusConverter x:Key="BooleanToStatusConverter"/>
        <conv:BoolToVisConverter x:Key="BoolToVis"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:InverseBoolToVisConverter x:Key="InverseBoolToVis"/>
        <conv:StatusColorConverter x:Key="StatusColorConverter"/>
        <conv:DeleteRestoreConverter x:Key="DeleteRestoreConverter"/>
        <conv:GenderConverter x:Key="GenderConverter"/>
        <conv:DateOnlyConverter x:Key="DateOnlyConverter"/>
        <conv:DateOnlyJsonConverter x:Key="DateOnlyJsonConverter"/>
        <conv:ShiftTypeConverter x:Key="ShiftTypeConverter"/>
        <conv:JobStatusConverter x:Key="JobStatusConverter"/>
        <conv:CertificateConverter x:Key="CertificateConverter"/>

        <conv:MorningShiftConverter x:Key="MorningShiftConverter"/>
        <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}">
            <views:UsersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DepartmentsViewModel}">
            <views:DepartmentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:JobTitlesViewModel}">
            <views:JobTitlesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShiftSettingsViewModel}">
            <views:ShiftSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmployeesViewModel}">
            <views:EmployeesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransferLogViewModel}">
            <views:TransferLogView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AbsentsViewModel}">
            <views:AbsentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditLogsViewModel}">
            <views:AuditLogsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LeavesViewModel}">
            <views:LeavesView/>
        </DataTemplate>
        <!-- NOTE: legacy MenuButtonStyle/ActionButtonStyle/LogoutButtonStyle removed 2026-09-21
             (verified unused: MainWindow uses local FluentMenuButton; use Gov* styles in Themes/). -->
    </ResourceDictionary>
    </Application.Resources>
</Application>