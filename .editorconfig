# EditorConfig — HospitalProject (net8.0 / C# / WPF, Arabic-first RTL)
# Shared coding conventions for all editors/IDEs. Mirrors the repo's actual style.

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# XML / solution files
[*.{slnx,xml,csproj,props,targets,config,resx}]
indent_size = 2

# Markdown / plain docs
[*.{md,mdx}]
trim_trailing_whitespace = false
insert_final_newline = true

# JSON (appsettings, package manifests)
[*.json]
indent_size = 2
insert_final_newline = true

# YAML (CI workflows if added)
[*.{yml,yaml}]
indent_size = 2

# C# — match existing conventions (4-space indent, UTF-8, explicit visibility)
[*.cs]
indent_size = 4
charset = utf-8

# Code Style — naming (keep repo quirks like "Veiw" DTO names; these don't touch naming rules)
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# Formatting
csharp_new_line_before_open_brace = all
csharp_indent_case_contents_when_block = true

# .NET / C# conventions
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_prefer_auto_properties = true:silent
dotnet_style_prefer_compound_assignment = true:suggestion
csharp_style_implicit_object_creation_when_type_is_apparent = false:suggestion
dotnet_style_namespace_match_folder = false:suggestion

# .NET Framework / WPF (Desktop is net8.0-windows; keep these harmless)
[*.{cs,vb}]
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion

# Files we should never reformat/commit
[appsettings*.json]
charset = utf-8

[Logs/**]
trim_trailing_whitespace = false
